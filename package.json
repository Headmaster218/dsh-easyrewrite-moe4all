{
  "name": "dsh-easyrewrite-moe4all",
  "version": "2.4.1-moe4all.2",
  "description": "MoE4All edition of the DSH message recall and re-edit plugin",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "slots",
        "sessions",
        "workspaces"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "README.ja.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "client-plugin",
    "ui",
    "plugin",
    "edit",
    "rewrite",
    "bubble-edit",
    "recall",
    "undo",
    "rollback",
    "version-pager",
    "撤回",
    "气泡编辑",
    "重编辑",
    "取り消し",
    "バブル編集",
    "編集",
    "i18n",
    "internationalization",
    "multilingual",
    "localization",
    "zh",
    "en",
    "ja"
  ],
  "license": "MIT",
  "scripts": {
    "build": "node build.mjs",
    "ci:check": "node --experimental-vm-modules ci/plugin-ci.mjs check",
    "ci:test": "node ci/plugin-ci.mjs test",
    "ci:contract": "node ci/plugin-ci.mjs test-contract",
    "release:build": "node --experimental-vm-modules ci/plugin-ci.mjs pack",
    "release:verify": "node ci/plugin-ci.mjs verify-release"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Headmaster218/dsh-easyrewrite-moe4all.git"
  },
  "homepage": "https://github.com/Headmaster218/dsh-easyrewrite-moe4all#readme",
  "bugs": {
    "url": "https://github.com/Headmaster218/dsh-easyrewrite-moe4all/issues"
  },
  "moe4all": {
    "upstream": "dsh-easyrewrite@2.4.1",
    "repository": "https://github.com/Renzic-Stone/DSH-EasyRewrite",
    "commit": "8bfa03c946e81e6159d0c839ffb7a02c6c52c158"
  },
  "packageManager": "npm@10.9.2"
}
